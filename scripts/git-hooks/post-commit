#!/bin/bash
set -e

# Solo versionamos desde main. Un bump en una rama de feature etiquetaría
# trabajo sin mergear, y con push.followTags ese tag publicaría un release.
# En rebase o detached HEAD, rev-parse devuelve "HEAD" y también salimos.
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$BRANCH" != "main" ]; then
	exit 0
fi

# El tipo se detecta SOLO sobre el asunto. Leyendo el mensaje completo,
# cualquier línea del cuerpo (un log de squash, una cita) disparaba un bump.
SUBJECT=$(git log -1 --pretty=%s)
BODY=$(git log -1 --pretty=%B)

# Evitar loop: no bumpear el propio commit de bump
if echo "$SUBJECT" | grep -qE "^bump\(version\):"; then
	exit 0
fi

# Detectar tipo de bump. En conventional commits el "!" marca breaking change
# sea cual sea el tipo, así que se comprueba antes. BREAKING CHANGE debe ser un
# footer de verdad: anclado a inicio de línea y sensible a mayúsculas, para que
# mencionar el término en prosa no provoque un major.
if echo "$SUBJECT" | grep -qiE "^[a-z]+(\([^)]*\))?!:"; then
	TYPE="major"
elif echo "$BODY" | grep -qE "^BREAKING[ -]CHANGE:"; then
	TYPE="major"
elif echo "$SUBJECT" | grep -qiE "^(fix|perf|revert)(\([^)]*\))?:"; then
	TYPE="patch"
elif echo "$SUBJECT" | grep -qiE "^feat(\([^)]*\))?:"; then
	TYPE="minor"
else
	exit 0
fi

# Leer versión actual
CURRENT=$(cat VERSION)
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"

case "$TYPE" in
patch)
	PATCH=$((PATCH + 1))
	;;
minor)
	MINOR=$((MINOR + 1))
	PATCH=0
	;;
major)
	MAJOR=$((MAJOR + 1))
	MINOR=0
	PATCH=0
	;;
esac

NEW_VERSION="$MAJOR.$MINOR.$PATCH"
echo "$NEW_VERSION" >VERSION
git add VERSION

# Usamos --no-verify para no disparar hooks en este commit interno
git commit --no-verify -m "bump(version): v$NEW_VERSION"
git tag -a "v$NEW_VERSION" -m "v$NEW_VERSION"
